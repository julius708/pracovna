# Copy to .env.local for local development. Never commit real values.

# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never NEXT_PUBLIC

# Guesty Open API (Integrations -> Developer tools -> OAuth applications)
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=
GUESTY_ACCOUNT_ID=682f39ceca0d576ff1aa1da7
GUESTY_WEBHOOK_SECRET=                # from GET /webhooks-v2/secret after registering the webhook
GUESTY_LAUNDRY_FIELD_ID=6ab385c5bcf98e0011a9419d
GUESTY_CLEANER_FIELD_ID=              # optional, once the "Upratovacia služba" field exists in Guesty

# Scheduled jobs (Vercel sends this as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=                          # random, at least 32 characters

# App
APP_URL=                              # public origin, e.g. https://pracovna-cyan.vercel.app (e-mail links, webhook URL); Vercel's production URL is the fallback
APP_ENV=staging                       # staging | production (SEED_MODE is refused in production)
SEED_MODE=false                       # true = fake Guesty client with generated data
LOG_LEVEL=info

# Optional
PRICELABS_API_KEY=                    # enables the PriceLabs min_stay fallback
ALERT_WEBHOOK_URL=                    # Slack/Telegram-style webhook for alerts
